{
  "name": "ruledesk",
  "productName": "RuleDesk",
  "version": "15.1.0",
  "description": "A modern desktop client for Rule34 imageboard content",
  "main": "out/main/main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KazeKaze93/ruledesk.git"
  },
  "scripts": {
    "// DEV FLOW": "---",
    "dev": "chcp 65001 && cross-env NODE_ENV=development electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "update-readme-version": "node scripts/update-readme-version.js",
    "// DATABASE": "---",
    "db:rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "db:rebuild:node": "npm rebuild better-sqlite3",
    "db:rebuild:all": "npm run db:rebuild && npm run db:rebuild:node",
    "db:migrate": "drizzle-kit push:sqlite --schema=./src/main/db/schema.ts --driver=better-sqlite --url=./metadata.db",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:studio": "npm run db:rebuild:node && drizzle-kit studio",
    "// QUALITY CONTROL": "---",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:img-attrs": "node scripts/check-img-loading-decoding.mjs",
    "validate": "npm run typecheck && npm run lint && npm run check:img-attrs",
    "// TESTING": "---",
    "pretest": "npm run db:rebuild:node",
    "test": "vitest run",
    "posttest": "npm run db:rebuild",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run db:rebuild:node && vitest run tests/integration",
    "test:integration:watch": "npm run db:rebuild:node && vitest tests/integration",
    "test:integration:electron-node": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:smoke:blacklist:browse": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run tests/integration/controllers/SearchController.blacklist.test.ts",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test:e2e:headless": "cross-env NODE_ENV=test playwright test",
    "test:verify": "npm run db:rebuild:all && npm run test:run",
    "// ARCHITECTURE & INQUISITOR": "---",
    "arch:stats": "inquisitor analyze .",
    "arch:police": "inquisitor police ./src",
    "arch:audit": "inquisitor audit ./src",
    "arch:deps": "inquisitor detox",
    "arch:viz": "inquisitor viz",
    "arch:review": "inquisitor review",
    "arch:gen": "inquisitor ctx",
    "// RELEASE": "---",
    "dist": "npm run build && electron-builder",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "booru",
    "desktop"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.20.6",
    "electron": "39.2.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "msw": "^2.12.7",
    "playwright": "^1.57.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^5.0.8",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@kazekaze93/repo-inquisitor": "github:KazeKaze93/repo-inquisitor",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.2.2",
    "drizzle-orm": "^0.29.3",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "fast-xml-parser": "^5.3.3",
    "https-proxy-agent": "^9.0.0",
    "i18next": "^25.7.2",
    "lucide-react": "^0.560.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.10.1",
    "react-virtuoso": "^4.17.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "recharts": "^3.8.1",
    "repomix": "^1.10.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "build": {
    "appId": "com.kaze.ruledesk",
    "productName": "RuleDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!**/.env",
      "package.json",
      "!**/settings.json",
      "!**/*.log",
      "!**/*.db",
      "!**/*.db-journal",
      "!**/*.map",
      "!**/scripts/**",
      "!**/.github/**",
      "!**/*.ts",
      "!**/*.tsx",
      "!vite.config.ts",
      "!electron.vite.config.ts",
      "!tailwind.config.js",
      "!postcss.config.js",
      "!drizzle.config.ts",
      "!**/tsconfig.json",
      "!**/.eslintrc*",
      "!**/.vscode",
      "drizzle/**",
      "!**/.gitattributes",
      "!.cursorrules",
      "!**/.ai/**",
      "!**/scripts/**",
      "!**/repomix.config.json",
      "!**/.ai/**",
      "!**/.cursorrules",
      "!**/repomix-output.*"
    ],
    "extraFiles": [],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "KazeKaze93",
      "repo": "ruledesk",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RuleDesk-Setup-${version}.${ext}",
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "RuleDesk-Portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ]
  }
}
